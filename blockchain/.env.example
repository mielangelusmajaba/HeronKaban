# Copy to blockchain/.env (never commit it). Testnet only, no real funds.

# Public BSC testnet RPC (chain id 97)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Private key of a THROWAWAY deployer wallet funded from the BSC testnet faucet.
# Never reuse a wallet that holds real funds.
DEPLOYER_PRIVATE_KEY=0x...

# Etherscan API v2 key (https://etherscan.io/apis), used for BscScan verification
ETHERSCAN_API_KEY=
