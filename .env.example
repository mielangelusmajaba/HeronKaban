# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values. NEXT_PUBLIC_* values are shipped to the browser.

# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API Keys) ───────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY, bypasses RLS.
SUPABASE_SECRET_KEY=

# ── Database (Drizzle ORM) ───────────────────────────
# Supabase → Connect → "Transaction pooler" URI (port 6543). Used by the app and drizzle-kit.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Student verification ─────────────────────────────
# UMak Google Workspace domain. Exact domain still TBC (PRD §5). Checked on the server.
ALLOWED_EMAIL_DOMAIN=umak.edu.ph

# ── AI (OpenRouter, free model only) ─────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# ── Blockchain (BNB Smart Chain testnet, chain id 97) ─
NEXT_PUBLIC_BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Filled in after deploying from /blockchain
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
